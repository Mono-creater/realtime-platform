// This is your Prisma schema file,
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 历史预警记录表（扩展字段，支持摄像头检测结果）
model WarningHistory {
  id        Int      @id @default(autoincrement())
  code      String   // 碳滑板编号
  content   String   // 预警内容（压力超限/导高超限/燃弧超限/拉出值超限）
  time      DateTime // 预警发生时间
  worker    String?  // 维修人工号
  remark    String?  // 备注（可存图片URL等）
  
  // ---------- 新增字段（摄像头检测结果） ----------
  level     String?   // 告警等级（一级、二级等）
  value     Float?    // 告警数值（如压力值260.2）
  carNumber String?   // 车号（如19）
  line      String?   // 线路（如5号线）
  station   String?   // 区站（如A站至B站）
  direction String?   // 行别（上行/下行）
  location  String?   // 定位点号（如RC11-073）
  mileage   String?   // 公里标（如K23+357）
  speed     Int?      // 速度（km/h）
  imageUrl  String?   // 故障图片URL
  videoUrl  String?   // 故障视频URL

  createdAt DateTime @default(now()) @map("created_at")
  @@map("warning_history")
}

// 超限统计快照表
model OverLimitSnapshot {
  id           Int      @id @default(autoincrement())
  title        String
  count        Int
  snapshotTime DateTime @map("snapshot_time")
  @@map("over_limit_snapshot")
}

// 用户表
model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String @default("viewer")
  @@map("users")
}