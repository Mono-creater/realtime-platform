# ============================================================
# 汇川 H5U PLC 接入 —— 环境变量参考（复制为 .env 后修改）
# 与操作手册《PLC接入操作手册.md》（桌面）第 6 章保持一致
# ============================================================

# ---------- 运行模式 ----------
# real       : 通过 Modbus TCP 采集真实 PLC（或 plc-simulator 模拟器）
# simulation : 纯模拟模式（无 PLC 参与，平台自生成数据）
PLC_MODE=real

# ---------- PLC 连接（Modbus TCP） ----------
PLC_HOST=192.168.1.88
PLC_PORT=502
PLC_UNIT_ID=1
# 采集周期 ms（真实 PLC 建议 1000-2000；配合模拟器可设 1000）
PLC_INTERVAL=2000
# 旧固件回退路径的缓冲条数（扩展协议下不生效）
PLC_WINDOW=10

# ---------- 寄存器地址（协议原地址，modbus-serial 不做 40001 偏移） ----------
# 默认段 30001-30022 适用于 D 区 ≥32767 的标准型 H5U。
# H5U Easy（AutoShop）D 区仅 D0-D8191，需将 plc-program/H5U_main.st
# 改用 D2001 段，并在此同步（例：PLC_REG_TEMP=2001 ... PLC_REG_WRITE_HEIGHT=2022）
PLC_REG_TEMP=30001
PLC_REG_PRESS=30002
PLC_REG_HUMID=30003
PLC_REG_STATUS=30004
PLC_REG_SEQ=30005
PLC_REG_SUB_BASE=30011
PLC_REG_WRITE_FORCE=30021
PLC_REG_WRITE_HEIGHT=30022

# ---------- 接触力模型（EN 50367:2012，需现场实测标定） ----------
# F = p_air × PANTO_A_EFF − PANTO_F_OFFSET（N）
PANTO_A_EFF=0.001
PANTO_F_OFFSET=0
# 接触力目标 N（EN 50367 静态接触力 70~120N）
PANTO_F_TARGET=100

# ---------- 受电弓运动学（两连杆剪式近似 θ2 = r·θ1） ----------
PANTO_L1=1200
PANTO_L2=1300
PANTO_THETA_RATIO=0.8
PANTO_H_TARGET=2400

# ---------- 控制引擎（位置式并联 PID，微分先行） ----------
CONTROL_INTERVAL=500
# 被控对象一阶滞后时间常数 s（与模拟器一致，真实值由 Z-N 整定测定）
PANTO_TAU_FORCE=2.0
PANTO_TAU_HEIGHT=0.5
# 比例阀+管路纯滞后 ms（Z-N 拟合需要 L > 0）
PANTO_DEADTIME_MS=600

# ---------- Z-N 阶跃整定 ----------
# 阶跃幅值 = 量程 × 百分比（默认 10% = 95kPa）
ZN_STEP_PCT=10
# 阶跃响应最长等待时间 s
ZN_SETTLE_MAX_S=60
# 调试：1 时打印拟合内部过程（排错手册第 9 章用）
ZN_DEBUG=0

# ---------- 服务器 ----------
PORT=3000

# ============================================================
# 以下仅 npm run plc-sim* 启动模拟器时读取（模拟 H5U 实体机）
# ============================================================
# 模拟器从站监听地址/端口/站号（平台 .env 的 PLC_HOST/PLC_PORT/PLC_UNIT_ID 指向它）
PLC_SIM_HOST=0.0.0.0
PLC_SIM_PORT=1502
PLC_SIM_UNIT=1
# 采样周期 ms（滑窗 10 条 → 1s 出一个均值包）
PLC_SIM_INTERVAL=100
# 基准环境（正常值）
PLC_SIM_BASE_TEMP=25
PLC_SIM_BASE_PRESS=250
PLC_SIM_BASE_HUMID=45
# 异常注入：temperature:high|low, pressure:high|low, humidity:high（逗号分隔，可留空）
PLC_SIM_ANOMALY=
